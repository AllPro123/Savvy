#!/usr/bin/env python3
"""
savvy-media — standalone image & video creation for your terminal.

Zero dependencies: pure Python 3 standard library.

  IMAGES
    online  (default) : AI-generated images from a text prompt
                        (free Pollinations API, no API key needed)
    offline (--offline): procedural generative art seeded by your prompt

  VIDEOS
    online  (default) : AI keyframes cross-faded into an MP4 (needs ffmpeg)
    offline (--offline): animated procedural art -> MP4 (ffmpeg) or
                        looping GIF (pure Python, no ffmpeg needed at all)

  EXAMPLES
    savvy-media image "a fox in a snowy forest, watercolor"
    savvy-media image "cyberpunk city at night" -W 1920 -H 1080 -o city.png
    savvy-media image "abstract waves" --offline --seed 7
    savvy-media video "drifting nebula clouds" --duration 8
    savvy-media video "lava lamp" --offline -o lava.gif

Install: drop this file anywhere on your PATH and `chmod +x` it, e.g.
    curl -o /usr/local/bin/savvy-media <raw url> && chmod +x /usr/local/bin/savvy-media
"""

import argparse
import colorsys
import hashlib
import math
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import zlib

__version__ = "1.0.0"

# ----------------------------------------------------------------------------
# Small helpers
# ----------------------------------------------------------------------------

def log(msg):
    print(f"[savvy-media] {msg}", flush=True)


def die(msg, code=1):
    print(f"[savvy-media] error: {msg}", file=sys.stderr, flush=True)
    sys.exit(code)


def slugify(text, max_len=40):
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return (slug[:max_len].rstrip("-")) or "output"


def prompt_seed(prompt, seed):
    """Deterministic 64-bit seed from prompt (+ optional user seed)."""
    material = f"{prompt}|{seed if seed is not None else ''}".encode("utf-8")
    return int.from_bytes(hashlib.sha256(material).digest()[:8], "big")


def have_ffmpeg():
    return shutil.which("ffmpeg") is not None


# ----------------------------------------------------------------------------
# PNG writer (pure stdlib)
# ----------------------------------------------------------------------------

def write_png(path, width, height, rgb_rows):
    """rgb_rows: iterable of `bytes`, each row = width*3 RGB bytes."""
    def chunk(tag, data):
        block = tag + data
        return struct.pack(">I", len(data)) + block + struct.pack(
            ">I", zlib.crc32(block) & 0xFFFFFFFF)

    raw = b"".join(b"\x00" + row for row in rgb_rows)  # filter type 0 per row
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)))
        f.write(chunk(b"IDAT", zlib.compress(raw, 6)))
        f.write(chunk(b"IEND", b""))


# ----------------------------------------------------------------------------
# Animated GIF writer (pure stdlib, palette-indexed frames)
# ----------------------------------------------------------------------------

def _lzw_encode(indices, min_code_size):
    clear = 1 << min_code_size
    eoi = clear + 1
    out = bytearray()
    bitbuf = 0
    bitcnt = 0

    def emit(code, size):
        nonlocal bitbuf, bitcnt
        bitbuf |= code << bitcnt
        bitcnt += size
        while bitcnt >= 8:
            out.append(bitbuf & 0xFF)
            bitbuf >>= 8
            bitcnt -= 8

    code_size = min_code_size + 1
    table = {}
    next_code = eoi + 1
    emit(clear, code_size)
    prefix = indices[0]
    for sym in indices[1:]:
        key = (prefix, sym)
        found = table.get(key)
        if found is not None:
            prefix = found
            continue
        emit(prefix, code_size)
        if next_code < 4096:
            table[key] = next_code
            next_code += 1
            # decoder's table lags one entry behind, so widen one code later
            if next_code == (1 << code_size) + 1 and code_size < 12:
                code_size += 1
        else:
            emit(clear, code_size)
            table.clear()
            code_size = min_code_size + 1
            next_code = eoi + 1
        prefix = sym
    emit(prefix, code_size)
    emit(eoi, code_size)
    if bitcnt:
        out.append(bitbuf & 0xFF)
    return bytes(out)


def write_gif(path, width, height, palette, frames, fps):
    """palette: 256 (r,g,b) tuples; frames: list of bytes/bytearray of
    palette indices (width*height each). Loops forever."""
    delay = max(2, round(100.0 / fps))  # hundredths of a second
    with open(path, "wb") as f:
        f.write(b"GIF89a")
        f.write(struct.pack("<HHBBB", width, height, 0xF7, 0, 0))  # 256-color GCT
        for r, g, b in palette:
            f.write(bytes((r, g, b)))
        # NETSCAPE looping extension
        f.write(b"\x21\xFF\x0BNETSCAPE2.0\x03\x01\x00\x00\x00")
        for frame in frames:
            f.write(b"\x21\xF9\x04\x04" + struct.pack("<H", delay) + b"\x00\x00")
            f.write(b"\x2C" + struct.pack("<HHHHB", 0, 0, width, height, 0))
            f.write(bytes([8]))  # LZW min code size
            data = _lzw_encode(frame, 8)
            for i in range(0, len(data), 255):
                block = data[i:i + 255]
                f.write(bytes([len(block)]) + block)
            f.write(b"\x00")
        f.write(b"\x3B")


# ----------------------------------------------------------------------------
# Procedural art (offline mode)
# ----------------------------------------------------------------------------

def build_palette(prompt, seed):
    """256-color palette derived from the prompt: a smooth ramp through
    hue-related anchor colors."""
    h = hashlib.sha256(f"palette|{prompt}|{seed}".encode()).digest()
    base_hue = h[0] / 255.0
    spread = 0.06 + (h[1] / 255.0) * 0.14
    scheme = h[2] % 3  # 0=analogous, 1=complementary accent, 2=triadic
    anchor_hues = [base_hue - spread, base_hue, base_hue + spread]
    if scheme == 1:
        anchor_hues.append(base_hue + 0.5)
    elif scheme == 2:
        anchor_hues += [base_hue + 1 / 3.0, base_hue + 2 / 3.0]

    anchors = []
    n = len(anchor_hues)
    for i, hue in enumerate(anchor_hues):
        t = i / max(1, n - 1)
        sat = 0.55 + 0.4 * math.sin(math.pi * t)
        val = 0.12 + 0.85 * t
        anchors.append(colorsys.hsv_to_rgb(hue % 1.0, min(sat, 1.0), min(val, 1.0)))

    palette = []
    for i in range(256):
        pos = (i / 255.0) * (len(anchors) - 1)
        lo = int(pos)
        hi = min(lo + 1, len(anchors) - 1)
        frac = pos - lo
        frac = frac * frac * (3 - 2 * frac)  # smoothstep for softer bands
        rgb = tuple(
            int(round(255 * (anchors[lo][c] * (1 - frac) + anchors[hi][c] * frac)))
            for c in range(3)
        )
        palette.append(rgb)
    return palette


class Plasma:
    """Classic multi-oscillator plasma field, seeded by the prompt.
    Renders palette indices; time is periodic so animations loop cleanly."""

    def __init__(self, prompt, seed, width, height):
        self.w = width
        self.h = height
        rnd = prompt_seed(prompt, seed)

        def take(lo, hi):
            nonlocal rnd
            rnd = (rnd * 6364136223846793005 + 1442695040888963407) & (2**64 - 1)
            return lo + (rnd >> 33) / float(2**31) * (hi - lo)

        s = min(width, height)
        self.f1 = take(4.0, 9.0) / s
        self.f2 = take(4.0, 9.0) / s
        self.f3 = take(3.0, 7.0) / s
        self.f4 = take(5.0, 11.0) / s
        # integer speeds -> perfect loop over one time cycle
        self.s1 = int(take(1, 3.999))
        self.s2 = int(take(1, 3.999))
        self.s3 = int(take(1, 2.999))
        self.s4 = int(take(1, 2.999))
        cx = width * take(0.3, 0.7)
        cy = height * take(0.3, 0.7)
        self.radius = [
            [math.hypot(x - cx, y - cy) for x in range(width)]
            for y in range(height)
        ]

    def frame(self, phase):
        """phase in [0, 2*pi); returns bytearray of palette indices."""
        w, h = self.w, self.h
        sin = math.sin
        tau = 2 * math.pi
        sx = [sin(x * self.f1 * tau + phase * self.s1) for x in range(w)]
        sy = [sin(y * self.f2 * tau + phase * self.s2) for y in range(h)]
        sxy = [sin(k * self.f3 * tau - phase * self.s3) for k in range(w + h)]
        f4t = self.f4 * tau
        s4p = phase * self.s4
        out = bytearray(w * h)
        pos = 0
        for y in range(h):
            row_r = self.radius[y]
            vy = sy[y]
            for x in range(w):
                v = sx[x] + vy + sxy[x + y] + sin(row_r[x] * f4t + s4p)
                # v in [-4, 4] -> 0..255
                out[pos] = int((v + 4.0) * 31.875)
                pos += 1
        return out


def indices_to_rgb_rows(indices, width, height, palette):
    flat = bytearray(width * height * 3)
    lut = [bytes(c) for c in palette]
    for i, idx in enumerate(indices):
        flat[i * 3:i * 3 + 3] = lut[idx]
    return [bytes(flat[y * width * 3:(y + 1) * width * 3]) for y in range(height)]


def offline_image(prompt, seed, width, height, out_path):
    log(f"offline mode: rendering procedural art ({width}x{height})...")
    palette = build_palette(prompt, seed)
    plasma = Plasma(prompt, seed, width, height)
    phase = (prompt_seed(prompt, seed) % 1000) / 1000.0 * 2 * math.pi
    indices = plasma.frame(phase)
    write_png(out_path, width, height, indices_to_rgb_rows(indices, width, height, palette))
    return out_path


def offline_video_frames(prompt, seed, width, height, n_frames):
    palette = build_palette(prompt, seed)
    plasma = Plasma(prompt, seed, width, height)
    frames = []
    for i in range(n_frames):
        frames.append(plasma.frame(2 * math.pi * i / n_frames))
        if (i + 1) % 10 == 0 or i + 1 == n_frames:
            log(f"  rendered frame {i + 1}/{n_frames}")
    return palette, frames


# ----------------------------------------------------------------------------
# AI generation (online mode) — Pollinations, free, no API key
# ----------------------------------------------------------------------------

POLLINATIONS_URL = "https://image.pollinations.ai/prompt/{prompt}?{params}"
USER_AGENT = "savvy-media/" + __version__


def fetch_ai_image(prompt, width, height, seed, model, out_path, retries=3):
    params = urllib.parse.urlencode({
        "width": width,
        "height": height,
        "seed": seed,
        "model": model,
        "nologo": "true",
    })
    url = POLLINATIONS_URL.format(prompt=urllib.parse.quote(prompt), params=params)
    last_err = None
    for attempt in range(1, retries + 1):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
            with urllib.request.urlopen(req, timeout=120) as resp:
                data = resp.read()
            if len(data) < 1024:
                raise ValueError("response too small to be an image")
            with open(out_path, "wb") as f:
                f.write(data)
            return out_path
        except Exception as e:  # noqa: BLE001 - report any network failure
            last_err = e
            if attempt < retries:
                wait = 2 ** attempt
                log(f"  attempt {attempt} failed ({e}); retrying in {wait}s...")
                time.sleep(wait)
    raise RuntimeError(f"could not reach image API after {retries} attempts: {last_err}")


# ----------------------------------------------------------------------------
# Video assembly
# ----------------------------------------------------------------------------

def run_ffmpeg(args):
    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y"] + args
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(f"ffmpeg failed:\n{proc.stderr.strip()}")


def frames_dir_to_mp4(frames_dir, fps, out_path):
    run_ffmpeg([
        "-framerate", str(fps),
        "-i", os.path.join(frames_dir, "frame_%04d.png"),
        "-c:v", "libx264", "-pix_fmt", "yuv420p", "-movflags", "+faststart",
        out_path,
    ])


def keyframes_to_crossfade_mp4(images, width, height, duration, fade, fps, out_path):
    n = len(images)
    per_clip = (duration + (n - 1) * fade) / n
    args = []
    for img in images:
        args += ["-loop", "1", "-t", f"{per_clip:.3f}", "-i", img]
    filters = []
    for i in range(n):
        filters.append(
            f"[{i}:v]scale={width}:{height}:force_original_aspect_ratio=increase,"
            f"crop={width}:{height},setsar=1,fps={fps}[s{i}]"
        )
    cur = "[s0]"
    for i in range(1, n):
        label = f"[x{i}]" if i < n - 1 else "[vout]"
        offset = i * (per_clip - fade)
        filters.append(
            f"{cur}[s{i}]xfade=transition=fade:duration={fade:.3f}:"
            f"offset={offset:.3f}{label}"
        )
        cur = label
    if n == 1:
        filters[-1] = filters[-1].replace("[s0]", "[vout]")
        cur = "[vout]"
    args += [
        "-filter_complex", ";".join(filters),
        "-map", cur, "-c:v", "libx264", "-pix_fmt", "yuv420p",
        "-movflags", "+faststart", out_path,
    ]
    run_ffmpeg(args)


# ----------------------------------------------------------------------------
# Commands
# ----------------------------------------------------------------------------

def cmd_image(args):
    out = args.output or slugify(args.prompt) + ".png"
    seed = args.seed if args.seed is not None else prompt_seed(args.prompt, None) % 10**9

    if args.offline:
        offline_image(args.prompt, args.seed, args.width, args.height, out)
    else:
        log(f'generating AI image for: "{args.prompt}" ({args.width}x{args.height}, '
            f"seed={seed}, model={args.model})")
        # AI endpoints return JPEG; name the file honestly unless user chose a name
        if args.output is None:
            out = slugify(args.prompt) + ".jpg"
        try:
            fetch_ai_image(args.prompt, args.width, args.height, seed, args.model, out)
        except RuntimeError as e:
            die(f"{e}\n  hint: no internet? try offline generative-art mode:\n"
                f'  savvy-media image "{args.prompt}" --offline')
    log(f"saved -> {out}")


def cmd_video(args):
    out = args.output or slugify(args.prompt) + (".mp4" if have_ffmpeg() or not args.offline else ".gif")

    if args.offline:
        n_frames = max(8, int(args.duration * args.fps))
        # keep pure-python rendering snappy: cap pixel count in offline mode
        width, height = args.width, args.height
        max_pixels = 640 * 400
        if width * height > max_pixels:
            scale = (max_pixels / (width * height)) ** 0.5
            width = max(2, int(width * scale) // 2 * 2)
            height = max(2, int(height * scale) // 2 * 2)
            log(f"capping offline resolution for speed: "
                f"{args.width}x{args.height} -> {width}x{height}")
        log(f"offline mode: rendering {n_frames} procedural frames "
            f"({width}x{height} @ {args.fps}fps)...")
        palette, frames = offline_video_frames(
            args.prompt, args.seed, width, height, n_frames)

        if out.lower().endswith(".gif") or not have_ffmpeg():
            if not out.lower().endswith(".gif"):
                out = os.path.splitext(out)[0] + ".gif"
                log("ffmpeg not found -> writing a looping GIF instead of MP4")
            write_gif(out, width, height, palette, frames, args.fps)
        else:
            with tempfile.TemporaryDirectory(prefix="savvy-media-") as tmp:
                for i, frame in enumerate(frames):
                    write_png(os.path.join(tmp, f"frame_{i:04d}.png"),
                              width, height,
                              indices_to_rgb_rows(frame, width, height, palette))
                frames_dir_to_mp4(tmp, args.fps, out)
    else:
        if not have_ffmpeg():
            die("AI video mode stitches keyframes with ffmpeg, which was not found "
                "on your PATH.\n  install it (e.g. `brew install ffmpeg` / "
                "`apt install ffmpeg`) or use --offline for a no-ffmpeg GIF.")
        seed0 = args.seed if args.seed is not None else prompt_seed(args.prompt, None) % 10**9
        log(f'generating {args.keyframes} AI keyframes for: "{args.prompt}"...')
        keep_dir = tempfile.mkdtemp(prefix="savvy-media-keyframes-")
        images = []
        try:
            for i in range(args.keyframes):
                path = os.path.join(keep_dir, f"key_{i:02d}.jpg")
                log(f"  keyframe {i + 1}/{args.keyframes} (seed={seed0 + i})")
                fetch_ai_image(args.prompt, args.width, args.height,
                               seed0 + i, args.model, path)
                images.append(path)
        except RuntimeError as e:
            shutil.rmtree(keep_dir, ignore_errors=True)
            die(f"{e}\n  hint: no internet? try offline mode:\n"
                f'  savvy-media video "{args.prompt}" --offline')
        log("stitching keyframes with crossfades (ffmpeg)...")
        try:
            keyframes_to_crossfade_mp4(images, args.width, args.height,
                                       args.duration, args.fade, args.fps, out)
        finally:
            shutil.rmtree(keep_dir, ignore_errors=True)
    log(f"saved -> {out}")


def build_parser():
    p = argparse.ArgumentParser(
        prog="savvy-media",
        description="Standalone image & video creation from your terminal "
                    "(AI when online, generative art offline; no dependencies).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__.split("EXAMPLES")[1].split("Install:")[0]
        if "EXAMPLES" in __doc__ else None,
    )
    p.add_argument("--version", action="version", version="%(prog)s " + __version__)
    sub = p.add_subparsers(dest="command", required=True)

    def common(sp, def_w, def_h):
        sp.add_argument("prompt", help="text description of what to create")
        sp.add_argument("-o", "--output", help="output file path")
        sp.add_argument("-W", "--width", type=int, default=def_w)
        sp.add_argument("-H", "--height", type=int, default=def_h)
        sp.add_argument("--seed", type=int, default=None,
                        help="seed for reproducible results")
        sp.add_argument("--model", default="flux",
                        help="AI model for online mode (flux, turbo)")
        sp.add_argument("--offline", action="store_true",
                        help="no-internet mode: procedural generative art")

    sp_img = sub.add_parser("image", help="create a single image")
    common(sp_img, 1024, 1024)
    sp_img.set_defaults(func=cmd_image)

    sp_vid = sub.add_parser("video", help="create a video (or GIF)")
    common(sp_vid, 960, 540)
    sp_vid.add_argument("--duration", type=float, default=6.0,
                        help="length in seconds (default 6)")
    sp_vid.add_argument("--fps", type=int, default=12,
                        help="frames per second (default 12)")
    sp_vid.add_argument("--keyframes", type=int, default=5,
                        help="AI keyframes to crossfade in online mode (default 5)")
    sp_vid.add_argument("--fade", type=float, default=1.0,
                        help="crossfade length in seconds, online mode (default 1)")
    sp_vid.set_defaults(func=cmd_video)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        args.func(args)
    except KeyboardInterrupt:
        die("interrupted", 130)


if __name__ == "__main__":
    main()
